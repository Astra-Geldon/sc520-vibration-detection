# ---- 编译产物：全部忽略 ----
td_project/*_Runs/
*.bit
*.sbit
*.bin
*.db
*.dcp
*.timing
*.timingsummary
*.rpt
*.log
*.log.err
*.logw
*.area
*.trp
*.dtrp

# ---- TD 工程运行时文件（每次编译都会重写）----
td_project/settings.cfg
td_project/*.adc

# ---- 系统文件 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 编辑器 ----
.vscode/
.idea/
*.swp
*~

# ---- 备份 ----
zhendong_defect/
*.zip
*.7z
*.rar

# ---- Python ----
__pycache__/
*.pyc

# ---- 注意 ----
# user_source/ip_source/*.xml 是 IP 核定义，.al 工程文件要用，必须提交！
# td_project/*.al 是工程文件本身，必须提交！

# ---- local work notes: never upload (see docs/plan/00-overview.md) ----
docs/

# ---- TD reports produced by td_project/flow_build.tcl ----
*.qor
*.ts
*.bid
# TD build scratch files
td_project/stdin_tmp.txt
td_project/tmp.err

# Local TD session metadata and archived build outputs
td_project/.lock.f
td_project/.recent_user_depot.ini
td_project/build_history/

# Generated CDC view and local execution/source snapshots
td_project/demo_cdc_physical_view.sdc
validation/green_lines_dsp_20261101/program.err
validation/green_lines_dsp_20261101/program.tcl
validation/green_lines_dsp_20261101/vib_bbox_grid.before.v
validation/green_lines_dsp_20261101/vib_bbox_grid.after.v

