//=====================================================================
//  uart_log_debug.v  ——  串口日志打印（老工程移植 + 逐步扩展）
//
//  作用：通过串口每秒打印一轮板级状态，用来确认 UART 通路是否打通、
//        时钟/像素速率是否符合预期、以及各功能块跑到哪一步了。
//
//  时钟：clk = I_sys_clk = 50 MHz（见 camera_to_dsi_display.sdc: sys_clk_50m）
//  引脚：tx -> O_uart_tx -> 板子 H1（见 pin.adc）
//  串口：115200 8N1；板子 TX(H1) 接 USB-TTL 的 RXD，GND 共地
//
//  ---------------------------------------------------------------------
//  每轮先打 1 行横幅，再打当前启用的视觉调试字段（目前 18 行），
//  每行 15 字节。隐藏字段仍保留原编号和快照连接，只是不发送。
//  （115200 下可在一个秒周期内打完）：
//
//      SC520 MIPI-HDMI UART LOG 115200 8N1\r\n
//      SEC  00000000   运行秒数（每轮 +1）
//      DIV  00000000   波特率分频值 = 50MHz/115200 = 434 = 0x1B2
//      PLL  00000000   PLL 锁定
//      DDR  00000000   DDR 初始化校准完成
//      CAM  00000000   摄像头寄存器配置完成（粘滞标志）
//      I2C  00000000   摄像头 I2C 错误（1 = 有错）
//      SID  00000000   摄像头 Sensor ID
//      SIOK 00000000   摄像头 ID 校验通过（0xEE4B / 0x9E4B）
//      MIPI 00000000   MIPI 诊断码 0..7
//      HS   00000000   已收到 MIPI HS 数据（粘滞标志）
//      CSIF 00000000   已解析出完整 CSI 帧（粘滞标志）
//      RAW  00000000   已出现 RAW10 流水（粘滞标志）
//      VID  00000000   已读到非零视频数据（粘滞标志）
//      CSIH 00000000   S_csi_rx_clk 实测频率(Hz)
//      PIXS 00000000   ISP 有效像素率(px/s)
//      FPS  00000000   每秒帧数
//      PXFR 00000000   每帧像素数，应 = 0x000E1000
//      DTRD 00000000   DDR 自检已读回字数，应 = 0x00003840
//      DTER 00000000   DDR 自检比较错误数，必须 = 0
//      VOFP 00000000   抽头每帧输出像素数，应 = 0x00038400
//      VOFL 00000000   抽头每帧输出行数，应 = 360
//      VSUM 00000000   抽头每帧灰度累加和（校验用，应非 0）
//      VTAP 00000000   抽头异常计数，必须 = 0
//      ITPX 00000000   上一帧差分像素数，应 = 0x00038400
//      ITLN 00000000   上一帧差分行数，应 = 360
//      ITSM 00000000   每帧 Σ|It|：静止接近 0，一动就涨
//      ITER 00000000   上一帧差分异常计数，必须 = 0
//      ITNW 00000000   每帧凑够一行次数，应约 360
//      ITST 00000000   状态 0=等行 1=取FIFO 2=读DDR 3=写回 4=等读回
//      ITSS 00000000   有符号 ΣIt：大=亮度变化，≈0=噪声/运动
//      GOFP 00000000   高斯级每帧输出像素数，应 = 0x00038400
//      GOFL 00000000   高斯级每帧输出行数，应 = 360
//      LKAX 00000000   块(0,0) ΣdIx²（dIx 未除2）
//      LKAY 00000000   块(0,0) ΣdIy²
//      LKXY 00000000   块(0,0) ΣdIx·dIy
//      LKBX 00000000   块(0,0) ΣdIx·It
//      LKBY 00000000   块(0,0) ΣdIy·It
//      LKEN 00000000   块(0,0) Σ|It|
//      LKPX 00000000   LK 每帧像素数，应 = 0x00038400
//      LKER 00000000   LK 异常计数，必须 = 0
//
//  判读方法：
//    * 能看到整齐的上面这些行        -> 波特率 / 帧格式 / 引脚 都对 ✓
//    * SEC 每秒 +1，连续不乱         -> 时钟假设正确 ✓
//    * DIV = 000001B2（434）         -> 分频值正确（50MHz 下 115200）✓
//    * PXFR = 000E1000（921600）     -> 视频流是 1280x720，抽头正确 ✓
//    * CSIH / PIXS                   -> 平均每像素几个 csi 时钟
//    * DTRD = 00003840 且 DTER = 0   -> DDR 算法区域读写自检通过 ✓
//    * 全是乱码                      -> 十有八九是 CLK_HZ 与真实时钟不符 ✗
//
//  ---------------------------------------------------------------------
//  ★ 与底层 uart_tx.v 的握手说明（沿用老工程踩过坑之后的写法）
//     底层 uart_tx.v 用的是 ready/valid 握手，但它的 tx_data_ready 不是
//     "空闲常高"，而且在状态切换那一拍有竞争。历史上用**电平**推进会出现
//     "每个字节被重发"（现象：串口里看到重复字符）。所以这里：
//        ① 等 tx_ready=1（uart 空闲）才装载下一个字节
//        ② tx_valid 只给 **1 拍脉冲**，数据与它同拍寄存
//        ③ 再等 ready 变低（字节被取走）后变高（这一字节发完）
//     这样 uart 每个字节只会在唯一的那个 IDLE 拍被锁存一次，不会重复 ✓
//  ---------------------------------------------------------------------
//  复位说明：rst_n 接 I_rst_n（板级复位），这样 PLL 还没锁的时候
//            串口就已经在打印了，便于定位问题。
//            状态输入分两类，都做了两拍同步：
//              a) 粘滞标志 / 慢变化电平（PLL/CAM/I2C/HS/...）—— 安全
//              b) 每秒刷新的测量值（CSIH/PIXS/FPS/PXFR/DTRD/DTER）
//                 —— 它们本来就只 1 秒变一次，跨域采样同样安全
//=====================================================================
module uart_log_debug #(
    parameter integer CLK_HZ = 50_000_000,   // 本模块时钟频率（Hz）
    parameter integer BAUD   = 115200        // 波特率
)(
    input  wire        clk,                 // I_sys_clk = 50MHz
    input  wire        rst_n,               // 异步复位，低有效
    input  wire        pll_lock,            // PLL 锁定
    input  wire        ddr_init_done,       // DDR 初始化校准完成
    input  wire        cam_cfg_done,        // 摄像头寄存器配置完成（粘滞）
    input  wire        cam_i2c_error,       // 摄像头 I2C 错误
    input  wire [15:0] sensor_id,           // 摄像头 Sensor ID
    input  wire        sensor_id_ok,        // 摄像头 ID 校验通过（0xEE4B/0x9E4B）
    input  wire [3:0]  mipi_diag_status,    // MIPI 诊断码 0..7
    input  wire        hs_seen,             // 已收到 MIPI HS 数据（粘滞）
    input  wire        csi_frame_seen,      // 已解析出 CSI 帧（粘滞）
    input  wire        raw10_seen,          // 已出现 RAW10 流水（粘滞）
    input  wire        video_nonzero_seen,  // 已读到非零视频数据（粘滞）
    input wire [31:0] csi_hz,             // 实测 S_csi_rx_clk 频率(Hz)
    input wire [31:0] px_per_sec,         // 实测像素率(px/s)
    input wire [31:0] fps,                // 实测帧率
    input wire [31:0] px_per_frame,       // 实测每帧像素数，应 = 0x000E1000
    input wire [31:0] ddr_words_read,     // DDR 自检读回字数，应 = 0x00003840
    input wire [31:0] ddr_err_cnt,        // DDR 自检比较错误数，必须 = 0
    input wire [31:0] tap_px_per_frame,   // 抽头每帧输出像素数(640x360)，应 = 0x00038400
    input wire [31:0] tap_lines,          // 抽头每帧输出行数，应 = 360 = 0x00000168
    input wire [31:0] tap_px_sum,         // 抽头每帧灰度累加和（松耦合校验，应非 0）
    input wire [31:0] tap_ovf,            // 抽头异常计数（溢出/对不齐），必须 = 0
    input wire [31:0] it_px,              // 每帧参与 It 的像素数，应 = 0x00038400
    input wire [31:0] it_lines,           // 每帧处理行数，应 = 360 = 0x00000168
    input wire [31:0] it_sum,             // 每帧 Σ|It|：静止场景接近 0，画面一动立刻涨
    input wire [31:0] it_err,             // 上一帧差分异常计数，必须 = 0
    input wire [31:0] it_line_rdy,        // 每帧'凑够一行'次数，正常约 360；=0 说明 csi 侧没数据
    input wire [31:0] it_state,           // 状态机状态 0=等行 1=取FIFO 2=读DDR 3=写回 4=等读回收齐
    input wire signed [31:0] it_sgn,      // 每帧有符号 ΣIt（补码）：量级大=整体亮度/增益变化，≈0=噪声或真实运动
    input wire [31:0] g_px,               // 高斯级每帧输出像素数，应 = 0x00038400
    input wire [15:0] g_lines,            // 高斯级每帧输出行数，应 = 360 = 0x00000168
    input wire signed [31:0] lk_axx,      // 块(0,0) 的 ΣdIx²，dIx = g[x+1]-g[x-1] 未除 2；= 4*Python 的 axx
    input wire signed [31:0] lk_ayy,      // 块(0,0) 的 ΣdIy²，dIy = g[y+1]-g[y-1] 未除 2；= 4*Python 的 ayy
    input wire signed [31:0] lk_axy,      // 块(0,0) 的 ΣdIx·dIy；= 4*Python 的 axy
    input wire signed [31:0] lk_bx,       // 块(0,0) 的 ΣdIx·It；= 2*Python 的 bx
    input wire signed [31:0] lk_by,       // 块(0,0) 的 ΣdIy·It；= 2*Python 的 by
    input wire signed [31:0] lk_en,       // 块(0,0) 的 Σ|It|，与 Python 的 energy 相同
    input wire [31:0] lk_px,              // LK 每帧参与累加的像素数，应 = 0x00038400
    input wire [31:0] lk_err,             // LK 异常计数，必须 = 0
    output wire        tx                   // 串口输出 -> O_uart_tx -> H1
);

    //------------------------------------------------------------------
    // 波特率分频（四舍五入）。这个值会被打印出来，方便核对 CLK_HZ 是否写对。
    //   50_000_000 / 115200 = 434.03 -> 434 = 0x1B2
    //------------------------------------------------------------------
    localparam [31:0] DIV = (CLK_HZ + BAUD/2) / BAUD;

    //------------------------------------------------------------------
    // 一轮消息的长度参数
    //------------------------------------------------------------------
    localparam integer NF        = 40;   // 状态行（字段）个数
    localparam integer FLD_LAST  = 40 - 1;
    localparam integer POS_LAST  = 15 - 1;
    localparam integer BIDX_LAST = 37 - 1;

    // 当前调试阶段只输出视觉链路和 LK 结果。
    // 字段编号保持原来的 0..39，隐藏字段不会改变顶层快照索引。
    function field_show;
        input [5:0] f;
        begin
            case (f)
            6'd0,                         // SEC
            6'd19, 6'd20,                 // VOFP/VOFL
            6'd23, 6'd24, 6'd25, 6'd26,  // ITPX/ITLN/ITSM/ITER
            6'd29,                         // ITSS
            6'd30, 6'd31,                 // GOFP/GOFL
            6'd32, 6'd33, 6'd34, 6'd35,
            6'd36, 6'd37, 6'd38, 6'd39:  // LKAX..LKER
                field_show = 1'b1;
            default:
                field_show = 1'b0;
            endcase
        end
    endfunction

    // 当前保留字段的顺序。被隐藏的字段直接跳过，不发送空行。
    function [5:0] next_field;
        input [5:0] f;
        begin
            case (f)
            6'd0:  next_field = 6'd19;
            6'd19: next_field = 6'd20;
            6'd20: next_field = 6'd23;
            6'd23: next_field = 6'd24;
            6'd24: next_field = 6'd25;
            6'd25: next_field = 6'd26;
            6'd26: next_field = 6'd29;
            6'd29: next_field = 6'd30;
            6'd30: next_field = 6'd31;
            6'd31: next_field = 6'd32;
            6'd32: next_field = 6'd33;
            6'd33: next_field = 6'd34;
            6'd34: next_field = 6'd35;
            6'd35: next_field = 6'd36;
            6'd36: next_field = 6'd37;
            6'd37: next_field = 6'd38;
            6'd38: next_field = 6'd39;
            default: next_field = 6'd39;
            endcase
        end
    endfunction

    //------------------------------------------------------------------
    // 1 秒节拍
    //   tick 复位成 CLK_HZ-1，于是复位后第一个时钟就产生一次节拍，
    //   上电后立刻先打一轮，之后才是每 1 秒一轮。
    //------------------------------------------------------------------
    reg  [31:0] tick;
    wire        tick_1s = (tick == (CLK_HZ - 1));

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) tick <= (CLK_HZ - 1);
        else        tick <= tick_1s ? 32'd0 : (tick + 32'd1);
    end

    //------------------------------------------------------------------
    // 跨时钟域同步：状态输入全是粘滞标志 / 慢变化电平，打两拍即可
    //------------------------------------------------------------------
    reg  [1:0]  pll_s, ddr_s, cam_s, i2c_s, hs_s, csif_s, raw_s, vid_s, siok_s;
    reg  [15:0] sid_s1, sid_s2;
    reg  [3:0]  mipi_s1, mipi_s2;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            pll_s  <= 2'b00; ddr_s  <= 2'b00; cam_s  <= 2'b00; i2c_s  <= 2'b00;
            hs_s   <= 2'b00; csif_s <= 2'b00; raw_s  <= 2'b00; vid_s  <= 2'b00;
            siok_s <= 2'b00;
            sid_s1 <= 16'd0; sid_s2 <= 16'd0;
            mipi_s1 <= 4'd0; mipi_s2 <= 4'd0;
        end
        else begin
            pll_s  <= {pll_s[0],  pll_lock};
            ddr_s  <= {ddr_s[0],  ddr_init_done};
            cam_s  <= {cam_s[0],  cam_cfg_done};
            i2c_s  <= {i2c_s[0],  cam_i2c_error};
            hs_s   <= {hs_s[0],   hs_seen};
            csif_s <= {csif_s[0], csi_frame_seen};
            raw_s  <= {raw_s[0],  raw10_seen};
            vid_s  <= {vid_s[0],  video_nonzero_seen};
            siok_s <= {siok_s[0], sensor_id_ok};
            mipi_s1 <= mipi_diag_status;
            mipi_s2 <= mipi_s1;
            // Sensor ID 在配置完成后才稳定，等配置完成再采样
            if (cam_s[1]) sid_s1 <= sensor_id;
            sid_s2 <= sid_s1;
        end
    end

    wire [3:0] mipi_code = mipi_s2;

    //------------------------------------------------------------------
    // 运行秒数（每打印完一轮 +1）
    //------------------------------------------------------------------
    reg  [31:0] run_sec;

    //------------------------------------------------------------------
    // 4 位十六进制 -> ASCII
    //------------------------------------------------------------------
    function [7:0] hx;
        input [3:0] n;
        begin
            if (n < 4'd10) hx = 8'h30 + {4'd0, n};          // '0'..'9'
            else           hx = 8'h41 + {4'd0, n} - 8'd10;  // 'A'..'F'
        end
    endfunction

    //------------------------------------------------------------------
    // 字段标签：给出第 f 个字段的第 p 个字符（p: 0..3，从左到右）
    //------------------------------------------------------------------
    function [7:0] lbl;
        input [5:0] f;
        input [1:0] p;
        reg  [31:0] s;
        begin
            case (f)
            6'd0 : s = "SEC ";
            6'd1 : s = "DIV ";
            6'd2 : s = "PLL ";
            6'd3 : s = "DDR ";
            6'd4 : s = "CAM ";
            6'd5 : s = "I2C ";
            6'd6 : s = "SID ";
            6'd7 : s = "SIOK";
            6'd8 : s = "MIPI";
            6'd9 : s = "HS  ";
            6'd10: s = "CSIF";
            6'd11: s = "RAW ";
            6'd12: s = "VID ";
            6'd13: s = "CSIH";
            6'd14: s = "PIXS";
            6'd15: s = "FPS ";
            6'd16: s = "PXFR";
            6'd17: s = "DTRD";
            6'd18: s = "DTER";
            6'd19: s = "VOFP";
            6'd20: s = "VOFL";
            6'd21: s = "VSUM";
            6'd22: s = "VTAP";
            6'd23: s = "ITPX";
            6'd24: s = "ITLN";
            6'd25: s = "ITSM";
            6'd26: s = "ITER";
            6'd27: s = "ITNW";
            6'd28: s = "ITST";
            6'd29: s = "ITSS";
            6'd30: s = "GOFP";
            6'd31: s = "GOFL";
            6'd32: s = "LKAX";
            6'd33: s = "LKAY";
            6'd34: s = "LKXY";
            6'd35: s = "LKBX";
            6'd36: s = "LKBY";
            6'd37: s = "LKEN";
            6'd38: s = "LKPX";
            6'd39: s = "LKER";
            default: s = "????";
            endcase
            case (p)
            2'd0:    lbl = s[31:24];
            2'd1:    lbl = s[23:16];
            2'd2:    lbl = s[15: 8];
            default: lbl = s[ 7: 0];
            endcase
        end
    endfunction

    //------------------------------------------------------------------
    // 当前字段的 32bit 值（由 fld 组合译码）
    //------------------------------------------------------------------
    reg  [31:0] v;

    always @(*) begin
        case (fld)
        6'd0 : v = run_sec           ; // 运行秒数（每轮 +1）
        6'd1 : v = DIV               ; // 波特率分频值 = 50MHz/115200 = 434 = 0x1B2
        6'd2 : v = {31'd0, pll_s[1]} ; // PLL 锁定
        6'd3 : v = {31'd0, ddr_s[1]} ; // DDR 初始化校准完成
        6'd4 : v = {31'd0, cam_s[1]} ; // 摄像头寄存器配置完成（粘滞标志）
        6'd5 : v = {31'd0, i2c_s[1]} ; // 摄像头 I2C 错误（1 = 有错）
        6'd6 : v = {16'd0, sid_s2}   ; // 摄像头 Sensor ID
        6'd7 : v = {31'd0, siok_s[1]}; // 摄像头 ID 校验通过（0xEE4B / 0x9E4B）
        6'd8 : v = {28'd0, mipi_code}; // MIPI 诊断码 0..7
        6'd9 : v = {31'd0, hs_s[1]}  ; // 已收到 MIPI HS 数据（粘滞标志）
        6'd10: v = {31'd0, csif_s[1]}; // 已解析出完整 CSI 帧（粘滞标志）
        6'd11: v = {31'd0, raw_s[1]} ; // 已出现 RAW10 流水（粘滞标志）
        6'd12: v = {31'd0, vid_s[1]} ; // 已读到非零视频数据（粘滞标志）
        6'd13: v = snap[13]          ; // S_csi_rx_clk 实测频率(Hz)
        6'd14: v = snap[14]          ; // ISP 有效像素率(px/s)
        6'd15: v = snap[15]          ; // 每秒帧数
        6'd16: v = snap[16]          ; // 每帧像素数，应 = 0x000E1000
        6'd17: v = snap[17]          ; // DDR 自检已读回字数，应 = 0x00003840
        6'd18: v = snap[18]          ; // DDR 自检比较错误数，必须 = 0
        6'd19: v = snap[19]          ; // 抽头每帧输出像素数，应 = 0x00038400
        6'd20: v = snap[20]          ; // 抽头每帧输出行数，应 = 360
        6'd21: v = snap[21]          ; // 抽头每帧灰度累加和（校验用，应非 0）
        6'd22: v = snap[22]          ; // 抽头异常计数，必须 = 0
        6'd23: v = snap[23]          ; // 上一帧差分像素数，应 = 0x00038400
        6'd24: v = snap[24]          ; // 上一帧差分行数，应 = 360
        6'd25: v = snap[25]          ; // 每帧 Σ|It|：静止接近 0，一动就涨
        6'd26: v = snap[26]          ; // 上一帧差分异常计数，必须 = 0
        6'd27: v = snap[27]          ; // 每帧凑够一行次数，应约 360
        6'd28: v = snap[28]          ; // 状态 0=等行 1=取FIFO 2=读DDR 3=写回 4=等读回
        6'd29: v = snap[29]          ; // 有符号 ΣIt：大=亮度变化，≈0=噪声/运动
        6'd30: v = snap[30]          ; // 高斯级每帧输出像素数，应 = 0x00038400
        6'd31: v = snap[31]          ; // 高斯级每帧输出行数，应 = 360
        6'd32: v = snap[32]          ; // 块(0,0) ΣdIx²（dIx 未除2）
        6'd33: v = snap[33]          ; // 块(0,0) ΣdIy²
        6'd34: v = snap[34]          ; // 块(0,0) ΣdIx·dIy
        6'd35: v = snap[35]          ; // 块(0,0) ΣdIx·It
        6'd36: v = snap[36]          ; // 块(0,0) ΣdIy·It
        6'd37: v = snap[37]          ; // 块(0,0) Σ|It|
        6'd38: v = snap[38]          ; // LK 每帧像素数，应 = 0x00038400
        6'd39: v = snap[39]          ; // LK 异常计数，必须 = 0
        default:  v = 32'd0;
        endcase
    end

    //------------------------------------------------------------------
    // 当前字段的十六进制 nibble（由 pos 组合译码，只见 pos = 5..12）
    //------------------------------------------------------------------
    reg  [3:0] nib;

    always @(*) begin
        case (pos)
        4'd5:    nib = v[31:28];
        4'd6:    nib = v[27:24];
        4'd7:    nib = v[23:20];
        4'd8:    nib = v[19:16];
        4'd9:    nib = v[15:12];
        4'd10:   nib = v[11: 8];
        4'd11:   nib = v[ 7: 4];
        default: nib = v[ 3: 0];
        endcase
    end

    //------------------------------------------------------------------
    // ★ 整轮日志的快照（本轮新增，修一个真实的观测问题）
    //
    //   下面的 v 是**组合译码**：每个字段是"发到它那一刻"才去取值。
    //   而一轮要发 55.3 ms，一帧只有 16.7 ms —— 于是
    //     ITSM(字段25) 与 ITSS(字段29) 相隔 4 字段 = 60 字节 = 5.2 ms，
    //     约 31% 的概率落在相邻两帧上。
    //   实测出现过 |ITSS| > ITSM（= 1.67e7 > 1.78e5），这违反三角不等式
    //   |ΣIt| <= Σ|It|，同帧绝不可能 —— 说明两个字段本来就来自不同帧，
    //   不是算法算错。
    //
    //   修法：每秒开轮的那一拍，把所有"会变的"字段（13 号及之后）
    //         一次性打进快照寄存器，整轮日志都从快照读 -> 同一轮内自洽。
    //   代价：27 个 32bit 寄存器。标志位/常量不必快照。
    //------------------------------------------------------------------
    wire        snap_ld = (st_r == ST_TICK) && tick_1s;   // 开轮那一拍
    reg  [31:0] snap [0:NF-1];

    always @(posedge clk) begin
        if (snap_ld) begin
            snap[13] <= csi_hz;
            snap[14] <= px_per_sec;
            snap[15] <= fps;
            snap[16] <= px_per_frame;
            snap[17] <= ddr_words_read;
            snap[18] <= ddr_err_cnt;
            snap[19] <= tap_px_per_frame;
            snap[20] <= tap_lines;
            snap[21] <= tap_px_sum;
            snap[22] <= tap_ovf;
            snap[23] <= it_px;
            snap[24] <= it_lines;
            snap[25] <= it_sum;
            snap[26] <= it_err;
            snap[27] <= it_line_rdy;
            snap[28] <= it_state;
            snap[29] <= it_sgn;
            snap[30] <= g_px;
            snap[31] <= g_lines;
            snap[32] <= lk_axx;
            snap[33] <= lk_ayy;
            snap[34] <= lk_axy;
            snap[35] <= lk_bx;
            snap[36] <= lk_by;
            snap[37] <= lk_en;
            snap[38] <= lk_px;
            snap[39] <= lk_err;
        end
    end

    //------------------------------------------------------------------
    // 横幅：由 bidx 组合译码，共 37 字节
    //------------------------------------------------------------------
    reg  [7:0] ban;

    always @(*) begin
        case (bidx)
        6'd0 : ban = "S"     ; // 'S'
        6'd1 : ban = "C"     ; // 'C'
        6'd2 : ban = "5"     ; // '5'
        6'd3 : ban = "2"     ; // '2'
        6'd4 : ban = "0"     ; // '0'
        6'd5 : ban = " "     ; // ' '
        6'd6 : ban = "M"     ; // 'M'
        6'd7 : ban = "I"     ; // 'I'
        6'd8 : ban = "P"     ; // 'P'
        6'd9 : ban = "I"     ; // 'I'
        6'd10: ban = "-"     ; // '-'
        6'd11: ban = "H"     ; // 'H'
        6'd12: ban = "D"     ; // 'D'
        6'd13: ban = "M"     ; // 'M'
        6'd14: ban = "I"     ; // 'I'
        6'd15: ban = " "     ; // ' '
        6'd16: ban = "U"     ; // 'U'
        6'd17: ban = "A"     ; // 'A'
        6'd18: ban = "R"     ; // 'R'
        6'd19: ban = "T"     ; // 'T'
        6'd20: ban = " "     ; // ' '
        6'd21: ban = "L"     ; // 'L'
        6'd22: ban = "O"     ; // 'O'
        6'd23: ban = "G"     ; // 'G'
        6'd24: ban = " "     ; // ' '
        6'd25: ban = "1"     ; // '1'
        6'd26: ban = "1"     ; // '1'
        6'd27: ban = "5"     ; // '5'
        6'd28: ban = "2"     ; // '2'
        6'd29: ban = "0"     ; // '0'
        6'd30: ban = "0"     ; // '0'
        6'd31: ban = " "     ; // ' '
        6'd32: ban = "8"     ; // '8'
        6'd33: ban = "N"     ; // 'N'
        6'd34: ban = "1"     ; // '1'
        6'd35: ban = 8'h0D   ; // '\r'
        6'd36: ban = 8'h0A   ; // '\n'
        default: ban = 8'h20;               // 空格
        endcase
    end

    //------------------------------------------------------------------
    // 一轮消息的字节指针
    //------------------------------------------------------------------
    reg              in_banner;   // 1 = 正在发横幅
    reg  [5:0] bidx;        // 横幅字节下标
    reg  [5:0] fld;         // 字段号
    reg  [3:0] pos;         // 字段内字节位置

    //------------------------------------------------------------------
    // 当前要发的字节
    //   横幅：全部来自 ban
    //   状态行：label(4) + space(1) + hex 8 位(8) + CR + LF = 15 字节
    //------------------------------------------------------------------
    reg  [7:0] cur;

    always @(*) begin
        if (in_banner)
            cur = ban;
        else if (pos < 4'd4)
            cur = lbl(fld, pos[1:0]);
        else if (pos == 4'd4)
            cur = 8'h20;                    // space
        else if (pos < 4'd13)
            cur = hx(nib);                  // 8 位十六进制，高位在前
        else if (pos == 4'd13)
            cur = 8'h0D;                    // CR
        else
            cur = 8'h0A;                    // LF
    end

    //------------------------------------------------------------------
    // 发送状态机（1 拍脉冲 + busy 等待，见文件头说明）
    //------------------------------------------------------------------
    localparam ST_TICK = 2'd0,   // 等 1 秒节拍
               ST_LOAD = 2'd1,   // 等 uart 空闲 -> 装载一个字节并给 pulse
               ST_BUSY = 2'd2;   // 等这一字节发完

    reg  [1:0] st_r;
    reg        tx_valid;
    reg  [7:0] tx_data;
    wire       tx_ready;
    reg        seen_low;         // 已经观察到 ready 变低（字节被取走）

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            st_r      <= ST_TICK;
            in_banner <= 1'b1;
            bidx      <= 0;
            fld       <= 0;
            pos       <= 0;
            run_sec   <= 32'd0;
            tx_valid  <= 1'b0;
            tx_data   <= 8'd0;
            seen_low  <= 1'b0;
        end
        else case (st_r)
        // ---------------- 等 1 秒节拍 ----------------
        ST_TICK: begin
            tx_valid <= 1'b0;
            if (tick_1s) begin
                in_banner <= 1'b1;
                bidx      <= 0;
                fld       <= 0;
                pos       <= 0;
                st_r      <= ST_LOAD;
            end
        end
        // ---------------- 装载一个字节 ----------------
        // 必须等 tx_ready=1（uart 在 IDLE 且没在收字节）才装载，
        // 这样 uart 只会在下一个 IDLE 拍锁存一次，不会重复发 ✓
        ST_LOAD: begin
            if (tx_ready) begin
                tx_data  <= cur;         // cur 由 in_banner/bidx/fld/pos 组合译码
                tx_valid <= 1'b1;        // 只给 1 拍脉冲
                seen_low <= 1'b0;
                st_r     <= ST_BUSY;
            end
        end
        // ---------------- 等这个字节发完，然后推进指针 ----------------
        ST_BUSY: begin
            tx_valid <= 1'b0;            // 脉冲已经给过了
            if (!tx_ready) begin
                seen_low <= 1'b1;        // 字节被取走
            end
            else if (seen_low) begin     // ready 回来了 = 这一字节发完
                if (in_banner) begin
                    if (bidx == BIDX_LAST) begin
                        in_banner <= 1'b0;   // 横幅发完，转入状态行
                        fld       <= 0;
                        pos       <= 0;
                    end
                    else begin
                        bidx <= bidx + 1'b1;
                    end
                    st_r <= ST_LOAD;
                end
                else if (pos != POS_LAST) begin
                    pos  <= pos + 1'b1;      // 同一行下一个字符
                    st_r <= ST_LOAD;
                end
                else if (fld != FLD_LAST) begin
                    pos  <= 0;               // 下一行
                    if (field_show(next_field(fld))) begin
                        fld  <= next_field(fld);
                        st_r <= ST_LOAD;
                    end
                    else begin
                        fld  <= FLD_LAST;
                        st_r <= ST_TICK;
                    end
                end
                else begin
                    run_sec <= run_sec + 32'd1;  // 一轮打完，秒数 +1
                    st_r    <= ST_TICK;
                end
            end
        end
        default: st_r <= ST_TICK;
        endcase
    end

    //------------------------------------------------------------------
    // 底层 UART 发送器（官方 uart_tx.v，未修改）
    //   注意：uart_tx 的 CLK_FRE 单位是 MHz，所以传 CLK_HZ/1000000 = 50
    //------------------------------------------------------------------
    uart_tx #(
        .CLK_FRE   (CLK_HZ / 1000000),
        .BAUD_RATE (BAUD)
    ) u_uart_tx (
        .clk           (clk),
        .rst_n         (rst_n),
        .tx_data       (tx_data),
        .tx_data_valid (tx_valid),
        .tx_data_ready (tx_ready),
        .tx_pin        (tx)
    );

endmodule
